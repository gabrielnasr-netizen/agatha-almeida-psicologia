# Copie este arquivo para .env.local (nunca commitar o .env.local de verdade)
# e preencha com os valores reais do projeto Supabase.

# Project Settings → API → Project URL
SUPABASE_URL=

# Project Settings → API → Project API keys → "anon" "public"
# É seguro esse valor não ser secreto, mas mesmo assim mantenha-o só em
# variável de ambiente (nunca hardcoded no código).
SUPABASE_ANON_KEY=

# Opcional: se/quando o domínio final existir, define a URL canônica do site
# (usada em SEO/Open Graph). Sem isso, o site usa a URL de produção da Vercel
# automaticamente.
# NEXT_PUBLIC_SITE_URL=https://agathaalmeida.com.br
